rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile protection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Project protection
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Only owner can update project metadata, or anyone can update JUST the feedbackCount
      allow update: if (request.auth != null && request.auth.uid == resource.data.ownerId) || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedbackCount']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      
      // Markers and comments are accessible for collaborative feedback
      match /markers/{markerId} {
        allow read, write: if true;
      }
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }
  }
}

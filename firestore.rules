rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile protection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /polaroids/{polaroidId} {
        allow read: if true;
        // Owner has full control. 
        // Visitors can create POSTITs.
        allow create: if request.auth != null && (request.auth.uid == userId || request.resource.data.type == 'POSTIT');
        // Only owner or original author can update/delete.
        allow update, delete: if request.auth != null && (request.auth.uid == userId || (resource.data.authorId != null && request.auth.uid == resource.data.authorId));
      }
    }
    
    // Project protection
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Only owner can update project metadata, or anyone can update JUST the feedbackCount
      allow update: if (request.auth != null && request.auth.uid == resource.data.ownerId) || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedbackCount']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      
      // Markers and comments are accessible for collaborative feedback
      match /markers/{markerId} {
        allow read, write: if true;
      }
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }
  }
}
